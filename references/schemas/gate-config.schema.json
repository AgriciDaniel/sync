{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sync.local/schemas/gate-config.schema.json",
  "title": "Sync project gate configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "operator_reviewed", "steps"],
  "properties": {
    "version": {"const": 2},
    "operator_reviewed": {"const": true},
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "argv", "hard"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
          "argv": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "hard": {"type": "boolean"},
          "timeout": {"type": "integer", "minimum": 1, "maximum": 7200},
          "skip_exit_codes": {"type": "array", "items": {"type": "integer"}},
          "skip_note": {"type": "string"}
        }
      }
    }
  }
}
